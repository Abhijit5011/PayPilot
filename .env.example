# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (TEST MODE ONLY) ─────────────────────────────────────────────────
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=

# ── LLM ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional fallback if Gemini quota is exhausted during the demo:
GROQ_API_KEY=

# ── n8n Cloud ────────────────────────────────────────────────────────────────
# Fill these in AFTER importing the workflows and activating them in n8n Cloud.
# Each is the "Production URL" shown on the workflow's Webhook node.
N8N_WORKFLOW_A_KILL_SWITCH_URL=
N8N_WORKFLOW_B_AI_AGENT_URL=

# Workflows C and D are internal (Execute-Workflow-Trigger only) and are never
# called over HTTP, so they have no webhook URLs and no entry here.

# ── Dashboard ────────────────────────────────────────────────────────────────
# Used only for the "who pressed the kill switch" audit prompt (see ADR-004).
# No default value — the dashboard always prompts the operator by name.
